#############################################
# Utility command for test

build tests/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\projects\brass\build-o2\tests && "C:\Program Files\CMake\bin\ctest.exe" "
  DESC = Running tests...
  pool = console
  restat = 1

build tests/test: phony tests/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build tests/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\projects\brass\build-o2\tests && "C:\Program Files\CMake\bin\cmake-gui.exe" -SD:\projects\brass -BD:\projects\brass\build-o2"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build tests/edit_cache: phony tests/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build tests/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\projects\brass\build-o2\tests && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SD:\projects\brass -BD:\projects\brass\build-o2"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build tests/rebuild_cache: phony tests/CMakeFiles/rebuild_cache.util

# =============================================================================
# Target aliases.

build brass: phony libbrass.a

build brass-opt: phony tools/brass-opt.exe

build brass-opt.exe: phony tools/brass-opt.exe

build brass_benchmarks: phony tests/brass_benchmarks.exe

build brass_benchmarks.exe: phony tests/brass_benchmarks.exe

build brass_unit_tests: phony tests/brass_unit_tests.exe

build brass_unit_tests.exe: phony tests/brass_unit_tests.exe

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: D:/projects/brass/build-o2

build all: phony libbrass.a tools/all tests/all

# =============================================================================

#############################################
# Folder: D:/projects/brass/build-o2/tests

build tests/all: phony tests/brass_unit_tests.exe tests/brass_benchmarks.exe

